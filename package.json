{
	"name": "projetech-studio",
	"version": "1.5.1",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "run build && node --test \"test/**/*.test.mjs\"",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-projetech-studio.git"
	},
	"engines": {
		"node": "^22.18",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~1.12.1",
		"fast-xml-parser": "^4.5.7"
	},
	"devDependencies": {
		"@companion-module/tools": "^2.8.0",
		"@types/node": "^22.20.5",
		"eslint": "^9.36.0",
		"prettier": "^3.6.2",
		"rimraf": "^6.1.3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.44.1"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.0"
}
